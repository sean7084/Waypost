# Copy this file to .env and adjust values for your local machine.
# Repository-local .env values are loaded automatically by manage.py, wsgi.py, and asgi.py.

# Django startup
DJANGO_SETTINGS_MODULE=waypost.settings

# Django core settings (read by waypost/settings.py).
# Local development works without these (safe defaults are built in).
# Production MUST set all of them explicitly.
# DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Encrypts stored mailbox/SMTP credentials at rest (Fernet). REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DJANGO_FIELD_ENCRYPTION_KEY=

# WeChat mini-program (Kering store-inspection client).
# AppID/AppSecret come from the WeChat MP console; AppSecret is server-side ONLY
# and both are REQUIRED when DJANGO_DEBUG=False (settings fail fast otherwise).
# WECHAT_MINI_APPID=
# WECHAT_MINI_APPSECRET=
# Signing key for mini-program JWTs; falls back to DJANGO_SECRET_KEY when unset.
# JWT_SIGNING_KEY=
# Token lifetimes (optional): JWT_ACCESS_HOURS=2, JWT_REFRESH_DAYS=14
# Code-upload key for LOCAL miniprogram-ci preview/upload (miniprogram/scripts/ci.js).
# NOT read by Django — it is a build/CI concern only. Set it to the PATH of the key
# downloaded from the MP console (开发管理 → 开发设置 → 小程序代码上传密钥), e.g. a
# private.wxXXXXXXXXXXXXXXXX.key file at the repo root (that file is git-ignored).
# For GitHub Actions, the WECHAT_CI_PRIVATE_KEY *secret* holds the key CONTENTS instead.
# WECHAT_CI_PRIVATE_KEY=private.wxXXXXXXXXXXXXXXXX.key

# Database (defaults to SQLite for development).
# For PostgreSQL in production, uncomment and set all of these:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=waypost_db
# DATABASE_USER=waypost_django
# DATABASE_PASSWORD=your_secure_password
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# Under Docker Compose you do NOT set these: docker-compose.yml derives them from
# the POSTGRES_* values below so the app and the db container cannot disagree.

# Cache (Redis) - production. Leave unset in dev to use an in-memory cache.
# Requires django-redis + redis (pinned in requirements.txt) and a running Redis server.
# DJANGO_REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# Under Docker Compose this is hardcoded to redis://redis:6379/1 (the service
# name); a 127.0.0.1 value here would point the app at its own container.

# ---------------------------------------------------------------------------
# Reverse proxy / TLS termination (read by settings.py).
#
# REQUIRED whenever Nginx terminates TLS in front of Gunicorn. Without
# DJANGO_SECURE_PROXY_SSL_HEADER Django believes the request is plain HTTP, and
# the CSRF Origin check then compares https://<host> against http://<host> -
# every POST, starting with login, fails with 403.
# ---------------------------------------------------------------------------
# DJANGO_SECURE_PROXY_SSL_HEADER=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ams.istore-tech.cn
# Cookie/redirect hardening. All default to enabled when DJANGO_DEBUG=False and
# are ignored when it is True, so local http://127.0.0.1 development is unaffected.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_SSL_REDIRECT=True
# HSTS is sticky: a browser caches it for the whole max-age and cannot be told to
# forget it. Leave at 0 until HTTPS is verified in production, then use 31536000.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Docker Compose / production ECS.
#
# Compose reads `.env` from its own directory for ${...} interpolation *and*
# passes it to the app via env_file, so this one file drives both. See
# docs/DEPLOYMENT.md, "Option 2: Docker Compose".
# ---------------------------------------------------------------------------
# POSTGRES_DB=waypost_db
# POSTGRES_USER=waypost_django
# POSTGRES_PASSWORD=replace-with-a-strong-password
# Host directory holding the media/ and template_files/ bind mounts. Must be
# owned by the user whose rootless Docker daemon runs the stack.
# WAYPOST_DATA_DIR=/home/deploy/waypost-data
# Set by docker/bin/ci-deploy.sh to the release being deployed; reported by
# /healthz/ so "which version is live?" is one curl.
# TAG=v0.2.0
# GIT_SHA=
# Build-time mirrors. Defaults are the public Aliyun mirrors; on the ECS itself
# prefer the internal ones, which cost no public bandwidth:
# APT_MIRROR=mirrors.cloud.aliyuncs.com
# PIP_INDEX_URL=http://mirrors.cloud.aliyuncs.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.cloud.aliyuncs.com

# Safety override for non-production email testing.
TEST_OUTBOUND_EMAIL_OVERRIDE=sean.liu@istore-tech.com

# Minimax RFQ integration
minimax_token_plan_key=
MINIMAX_RFQ_API_URL=https://api.minimaxi.com/anthropic/v1/messages
MINIMAX_RFQ_MODEL=MiniMax-M2.7-highspeed
MINIMAX_RFQ_TIMEOUT_SECONDS=30
MINIMAX_RFQ_MAX_TOKENS=800

# Windows WeasyPrint runtime overrides
# Default MSYS2 installs under C:\msys64 are auto-detected. Set these only if your GTK runtime lives elsewhere.
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin
# WEASYPRINT_DLL_DIR=C:\path\to\gtk\bin
# MSYS2_ROOT=C:\msys64

# Advanced Windows Fontconfig overrides
# FONTCONFIG_PATH=C:\path\to\runtime\fontconfig
# FONTCONFIG_FILE=C:\path\to\runtime\fontconfig\fonts.conf
# XDG_CACHE_HOME=C:\path\to\fontconfig-cache

# Auto-managed environment variables referenced by the app/runtime.
# These are typically provided by Windows or Django and usually should not be set in .env.
# The project runs on a repo-local venv (.venv); conda is no longer used.
# waypost/runtime_setup.py still honours CONDA_PREFIX/Library/bin as one optional
# WeasyPrint DLL location, so leave this commented unless you use an MSYS2/conda GTK runtime.
# CONDA_PREFIX=C:\path\to\gtk\runtime
# LOCALAPPDATA=C:\Users\your-user\AppData\Local
# PATH=C:\path\to\extra\bin;%PATH%
# RUN_MAIN=true