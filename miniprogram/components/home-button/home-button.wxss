/* Floating "home" button. Colours come from the shared design tokens so the
   component matches the web app; do not hardcode colours here. */
.home-btn {
  position: fixed;
  right: var(--wp-space-4);
  bottom: var(--wp-space-8);
  width: 56px;
  height: 56px;
  border-radius: var(--wp-radius-circle);
  background: var(--wp-color-primary);
  color: var(--wp-color-primary-contrast);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--wp-shadow-3);
  z-index: var(--wp-z-fixed);
}
.home-icon {
  font-size: var(--wp-font-size-xl);
  line-height: 1;
}
