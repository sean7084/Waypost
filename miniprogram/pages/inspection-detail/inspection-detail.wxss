/* Inspection detail: nav grid for the workflow pages. */
.nav-grid {
  display: flex;
  flex-wrap: wrap;
}

.nav-item {
  width: 30%;
  margin: 1.5%;
  padding: var(--wp-space-4) 0;
  text-align: center;
  background: var(--wp-color-primary-subtle);
  color: var(--wp-color-primary-active);
  border-radius: var(--wp-radius-md);
  font-size: var(--wp-font-size-sm);
  font-weight: var(--wp-font-weight-medium);
}
