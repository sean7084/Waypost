{
  "meta": {
    "name": "Waypost Design Tokens",
    "version": "1.0.0",
    "prefix": "--wp-",
    "description": "Single source of truth for the Waypost design language. scripts/build_design_tokens.py generates static/css/tokens.css (backend) and miniprogram/styles/tokens.wxss (WeChat mini program) from this file so both surfaces stay identical. Never hand-edit the generated files; edit this JSON and re-run the generator. See docs/DESIGN_SYSTEM.md."
  },
  "color": {
    "bg": "#F6F7F9",
    "surface": "#FFFFFF",
    "surface-subtle": "#FBFBFC",
    "surface-sunken": "#F1F3F5",
    "border": "#E3E6EA",
    "border-strong": "#CDD2D9",
    "text": "#1A1D21",
    "text-muted": "#5B6472",
    "text-subtle": "#6B7480",
    "text-inverse": "#FFFFFF",
    "primary": "#2F6FED",
    "primary-hover": "#1F5AD1",
    "primary-active": "#1A4BB0",
    "primary-contrast": "#FFFFFF",
    "primary-subtle": "#EAF0FE",
    "primary-subtle-hover": "#DCE7FD",
    "success": "#1A7F37",
    "success-hover": "#166B2E",
    "success-subtle": "#E7F5EC",
    "warning": "#9A6700",
    "warning-hover": "#855900",
    "warning-subtle": "#FCF3E0",
    "danger": "#CF222E",
    "danger-hover": "#B21D27",
    "danger-subtle": "#FBE9EA",
    "info": "#0969DA",
    "info-hover": "#0859BA",
    "info-subtle": "#E7F0FB",
    "neutral-50": "#F6F7F9",
    "neutral-100": "#ECEEF1",
    "neutral-200": "#E3E6EA",
    "neutral-300": "#CDD2D9",
    "neutral-400": "#9AA3AF",
    "neutral-500": "#6B7480",
    "neutral-600": "#5B6472",
    "neutral-700": "#3D444D",
    "neutral-800": "#2A2E34",
    "neutral-900": "#1A1D21",
    "focus-ring": "rgba(47, 111, 237, 0.35)",
    "overlay": "rgba(16, 24, 40, 0.45)",
    "scrim": "rgba(16, 24, 40, 0.06)",
    "brand-olive": "#4F6228",
    "brand-olive-subtle": "#EEF1E6"
  },
  "font": {
    "family-base": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "family-mono": "'SF Mono', SFMono-Regular, ui-monospace, 'Cascadia Code', 'Segoe UI Mono', Menlo, Consolas, monospace",
    "size-xs": "12px",
    "size-sm": "13px",
    "size-base": "14px",
    "size-md": "16px",
    "size-lg": "18px",
    "size-xl": "22px",
    "size-2xl": "28px",
    "size-3xl": "34px",
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-semibold": "600",
    "weight-bold": "700",
    "line-tight": "1.25",
    "line-base": "1.5",
    "line-relaxed": "1.65"
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px",
    "circle": "50%"
  },
  "shadow": {
    "1": "0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.10)",
    "2": "0 4px 8px -2px rgba(16, 24, 40, 0.08), 0 2px 4px -2px rgba(16, 24, 40, 0.06)",
    "3": "0 12px 24px -6px rgba(16, 24, 40, 0.12), 0 4px 8px -4px rgba(16, 24, 40, 0.08)"
  },
  "z": {
    "base": "0",
    "raised": "1",
    "dropdown": "1000",
    "sticky": "1020",
    "fixed": "1030",
    "modal-backdrop": "1040",
    "modal": "1050",
    "popover": "1060",
    "tooltip": "1070"
  },
  "control": {
    "height-sm": "32px",
    "height-md": "40px",
    "height-lg": "48px",
    "touch-target": "44px",
    "border-width": "1px",
    "pad-x": "16px",
    "pad-y": "8px"
  },
  "motion": {
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-slow": "320ms",
    "easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "easing-emphasis": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "nav": {
    "height": "60px",
    "bg": "#FFFFFF",
    "border": "#E3E6EA",
    "text": "#1A1D21",
    "text-muted": "#5B6472",
    "accent": "#2F6FED"
  }
}
