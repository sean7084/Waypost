<view class="page">
  <view class="card login-card">
    <text class="title brand">泓问</text>
    <text class="muted brand-sub">设备排障 · 知识问答 · 语音助手</text>

    <view wx:if="{{loading}}" class="state-box">
      <text class="muted">正在登录...</text>
    </view>

    <view wx:elif="{{navigating}}" class="state-box">
      <text class="muted">验证成功，正在进入聊天...</text>
    </view>

    <view wx:elif="{{isNewUser}}" class="state-box">
      <text class="muted">欢迎使用泓问！请授权以继续。</text>
      <text wx:if="{{statusError}}" class="error-text">{{statusError}}</text>
      <button class="btn btn-block" hover-class="btn-hover" bindtap="handleAuthorize">授权登录</button>
    </view>

    <view wx:else class="state-box">
      <text class="muted">{{loginPrompt}}</text>
      <text wx:if="{{statusError}}" class="error-text">{{statusError}}</text>
      <button class="btn btn-block" hover-class="btn-hover" bindtap="doLogin">微信登录</button>
    </view>
  </view>
</view>