.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--wp-space-8) var(--wp-space-5);
  background: var(--wp-color-bg);
}

.login-card {
  width: 100%;
  text-align: center;
}

.brand {
  display: block;
  margin-bottom: var(--wp-space-2);
}

.brand-sub {
  display: block;
  margin-bottom: var(--wp-space-6);
}

.state-box {
  display: flex;
  flex-direction: column;
  gap: var(--wp-space-4);
}

.state-box .muted {
  font-size: var(--wp-font-size-base);
}