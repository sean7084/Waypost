.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--wp-color-bg);
  overflow: hidden;
}

/* --- custom header ------------------------------------------------------- */
.chat-header-spacer {
  flex: 0 0 auto;
}

.chat-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 var(--wp-space-3) var(--wp-space-1);
}

.chat-header-side {
  width: 76rpx;
  display: flex;
  align-items: center;
}

.chat-header-title {
  flex: 1;
  text-align: center;
  font-size: var(--wp-font-size-lg);
  font-weight: var(--wp-font-weight-bold);
  color: var(--wp-color-text);
}

.menu-trigger {
  width: 68rpx;
  height: 68rpx;
  box-sizing: border-box;
  padding: 0 var(--wp-space-4);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 7rpx;
  border-radius: var(--wp-radius-lg);
  border: 1px solid var(--wp-color-border);
  background: var(--wp-color-surface);
  box-shadow: var(--wp-shadow-1);
}

.menu-trigger-hover {
  background: var(--wp-color-surface-sunken);
}

.menu-trigger-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: var(--wp-radius-pill);
  background: var(--wp-color-text);
  align-self: center;
}

.menu-trigger-line-short {
  width: 20rpx;
}

/* --- session drawer ------------------------------------------------------ */
.sidebar-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--wp-z-modal-backdrop);
  background: var(--wp-color-overlay);
}

.sidebar-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 560rpx;
  max-width: 84vw;
  box-sizing: border-box;
  background: var(--wp-color-surface);
  box-shadow: var(--wp-shadow-3);
}

.sidebar-shell {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.sidebar-scroll {
  flex: 1;
  min-height: 0;
  padding: var(--wp-space-3);
  box-sizing: border-box;
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: var(--wp-space-3);
}

.sidebar-section + .sidebar-section {
  margin-top: var(--wp-space-6);
}

.sidebar-section-primary {
  margin-bottom: var(--wp-space-2);
}

.sidebar-action {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  gap: var(--wp-space-3);
  padding: var(--wp-space-2) var(--wp-space-3);
  border-radius: var(--wp-radius-md);
  border: 1px solid var(--wp-color-border);
  background: var(--wp-color-primary-subtle);
}

.sidebar-action-hover {
  background: var(--wp-color-primary-subtle-hover);
}

.sidebar-action-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--wp-radius-circle);
  background: var(--wp-color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-action-icon-mark {
  color: var(--wp-color-primary-contrast);
  font-size: var(--wp-font-size-lg);
  line-height: 1;
}

.sidebar-action-title {
  font-size: var(--wp-font-size-base);
  font-weight: var(--wp-font-weight-semibold);
  color: var(--wp-color-primary-active);
}

.sidebar-section-title {
  font-size: var(--wp-font-size-sm);
  font-weight: var(--wp-font-weight-semibold);
  color: var(--wp-color-text-muted);
}

.sidebar-history-state {
  font-size: var(--wp-font-size-sm);
  color: var(--wp-color-text-subtle);
  padding: var(--wp-space-2) 0;
}

.sidebar-history-state-error {
  color: var(--wp-color-danger);
}

.sidebar-history-list {
  display: flex;
  flex-direction: column;
  gap: var(--wp-space-2);
}

.session-item {
  display: flex;
  align-items: center;
  gap: var(--wp-space-1);
  border-radius: var(--wp-radius-md);
  border: 1px solid transparent;
  padding: var(--wp-space-2);
}

.session-item-active {
  background: var(--wp-color-primary-subtle);
  border-color: var(--wp-color-primary-subtle-hover);
}

.session-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--wp-space-2);
}

.session-item-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.session-item-title {
  font-size: var(--wp-font-size-base);
  color: var(--wp-color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-item-preview {
  font-size: var(--wp-font-size-xs);
  color: var(--wp-color-text-subtle);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-item-time {
  font-size: var(--wp-font-size-xs);
  color: var(--wp-color-text-subtle);
  flex-shrink: 0;
}

.session-item-action {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--wp-radius-circle);
}

.session-item-action-busy {
  background: var(--wp-color-surface-sunken);
}

.session-item-action-mark {
  color: var(--wp-color-text-muted);
  font-size: var(--wp-font-size-base);
  line-height: 1;
}

.sidebar-footer {
  flex: 0 0 auto;
  padding: var(--wp-space-2) var(--wp-space-3) var(--wp-space-5);
}

.sidebar-footer-divider {
  height: 1px;
  background: var(--wp-color-border);
  margin-bottom: var(--wp-space-2);
}

.sidebar-logout {
  min-height: var(--wp-control-touch-target);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--wp-radius-md);
}

.sidebar-logout-hover {
  background: var(--wp-color-danger-subtle);
}

.sidebar-logout-label {
  font-size: var(--wp-font-size-base);
  color: var(--wp-color-danger);
  font-weight: var(--wp-font-weight-medium);
}

/* --- phone authorization banner ------------------------------------------ */
.banner {
  flex: 0 0 auto;
  padding: 0 var(--wp-space-3) var(--wp-space-2);
}

.phone-btn {
  margin: 0;
  padding: 0 var(--wp-space-3);
  min-height: var(--wp-control-height-sm);
  line-height: var(--wp-control-height-sm);
  font-size: var(--wp-font-size-xs);
  font-weight: var(--wp-font-weight-medium);
  color: var(--wp-color-warning);
  background: var(--wp-color-warning-subtle);
  border: 1px solid var(--wp-color-warning-subtle);
  border-radius: var(--wp-radius-md);
}

.phone-btn::after {
  border: none;
}

/* --- conversation -------------------------------------------------------- */
.message-area {
  flex: 1;
  min-height: 0;
  display: block;
}

.pending-media {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: var(--wp-space-2);
  margin: 0 var(--wp-space-3) var(--wp-space-2);
  padding: var(--wp-space-2);
  border-radius: var(--wp-radius-md);
  border: 1px solid var(--wp-color-border);
  background: var(--wp-color-surface);
}

.pending-media-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--wp-radius-sm);
  flex-shrink: 0;
}

.pending-media-label {
  flex: 1;
  min-width: 0;
  font-size: var(--wp-font-size-xs);
  color: var(--wp-color-text-muted);
}

.pending-media-clear {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--wp-radius-circle);
  background: var(--wp-color-surface-sunken);
  color: var(--wp-color-text-muted);
}

.input-wrap {
  flex: 0 0 auto;
  padding: 0 var(--wp-space-3) var(--wp-space-4);
}